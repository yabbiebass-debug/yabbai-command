# YABBAI Command - backend configuration
# Copy to .env for local development. Production values go in the Render
# dashboard, never in a committed file.
#
# ASCII ONLY. slowapi builds a starlette Config that reads this file with the
# system codepage, not UTF-8. A single non-ASCII character (an em-dash, say)
# raises UnicodeDecodeError at import and the server never starts.


# == REQUIRED ==================================================================

# MongoDB. server.py reads this with os.environ['MONGO_URL'], so the process
# will not start without it. Use a MongoDB Atlas M0 for the Render deployment
# and allow 0.0.0.0/0 in Atlas network access, since Render free instances have
# no static egress IP.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=yabbai

# Identity provider. Sensitive routes fail closed: 503 when unset, 401 without
# a valid session.
HUB_AUTH_URL=https://yabbai.network


# == TOKEN =====================================================================
# These make a fresh deployment self-configuring. Without them the database is
# empty on first boot and the public endpoints report configured:false, since
# the only route that could seed the mint is director-only.

TOKEN_MINT=FXzGbxw38xBzTdwRe4YoGBA9toWat4vSVvvAgN5Ljupx
TREASURY_WALLET=HTN1fvHwbzKiMwh9YXZEe3eooiMdoCAs3TweWdiSZV5i


# == SOLANA RPC ================================================================

# Primary endpoint. Chainstack's shared tier refuses getProgramAccounts,
# getTokenLargestAccounts and getTokenAccountsByOwner, which power holder count,
# top-holder concentration and treasury token balance.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Tried in order when the primary refuses a method on plan grounds. A refusal is
# remembered per endpoint, so a provider that has declined is not asked again.
# Defaults to this list, so it works unset.
SOLANA_RPC_FALLBACKS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com,https://rpc.ankr.com/solana

# Raises Jupiter price rate limits. Prices work without it.
JUPITER_API_KEY=


# == AGENTS ====================================================================

# Seconds a token measurement is shared across agents. Fifty agents cycling
# every ten seconds is up to 300 provider calls a minute for data that changes
# far more slowly; uncached it rate-limited Jupiter and turned a real price into
# a DATA GAP through self-inflicted load alone. 30s cut it from ~50 measurements
# per two minutes to 6, with zero gaps.
TOKEN_MEASUREMENT_TTL=30

# How often a real mainnet observation is written to price_history and
# treasury_snapshots. These rows are what /api/performance measures.
SNAPSHOT_INTERVAL_SECONDS=300


# == REVENUE WEBHOOKS ==========================================================
# These book REAL income into the truth ledger, and real_income() is what the
# withdraw phase reads when deciding whether to propose a payout. Verification
# fails closed: with no secret set, no income can be booked from any source.
#
# Set this to a long random string, then configure the same value as the signing
# secret in Stripe / Gumroad / PayPal.

WEBHOOK_SECRET=

# Optional per-source overrides, which take precedence over the shared secret.
# WEBHOOK_SECRET_PRODUCT=
# WEBHOOK_SECRET_INVOICE=
# WEBHOOK_SECRET_SWEEP=

# Rejects a signed request older than this, bounding replay.
WEBHOOK_MAX_AGE_SECONDS=300


# == AI GATEWAY (optional) =====================================================
# Routing, keys and provider fallback all live on the hub. This service holds no
# provider keys and selects no model.

# YABBAI_API_KEY=
# HUB_AI_PATH=/api/ai/chat


# == CORS ======================================================================
# Never '*' while credentials are allowed: that lets any site on the internet
# make authenticated calls on behalf of a signed-in Director. The server refuses
# a wildcard and falls back to the known-host list.
#
# Only hosts that actually serve something:
#   yabbai.network          hub, issues the session
#   token.yabbai.network    director console   (Render service yabbai-token)
#   holders.yabbai.network  public view        (Render service yabbai-holders)
# The API itself (api.yabbai.network, service yabbai-api) is the origin being
# called, not a caller, so it does not belong in this list.
CORS_ORIGINS=https://yabbai.network,https://token.yabbai.network,https://holders.yabbai.network


# == BUYBACKS (optional) =======================================================
# Bounds on what the agents may propose. They cannot execute: every buy is
# signed by the operator's own wallet, so no key here can spend the treasury.
# Buybacks are off until buyback_enabled is turned on in Settings.
# BUYBACK_MIN_RESERVE_SOL=0.05     # never spend below this; fees must stay payable
# BUYBACK_MAX_FRACTION=0.25        # ceiling per proposal, before risk/reinvest scaling
# BUYBACK_MAX_IMPACT_PCT=5.0       # refuse a quote that moves the price more than this
# BUYBACK_COOLDOWN_MINUTES=60      # minimum gap between proposals
# BUYBACK_PROPOSAL_TTL_HOURS=6     # expire a proposal rather than leave a stale quote


# == SPEND CAPS (optional) =====================================================
# MICRO_SPEND_CAP=2.0
# SPEND_CAP=25.0
# DAILY_SPEND_CAP=100.0
# DAILY_LOSS_CAP=15.0
