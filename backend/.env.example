# YABBAI Command — backend configuration
# Copy to .env and fill in. Never commit the real .env.

# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string. server.py reads this with os.environ['MONGO_URL'],
# so the process will not start without it.
MONGO_URL=mongodb://localhost:27017

# Identity provider. Sensitive routes fail closed:
#   unset            -> 503
#   set, no cookie   -> 401
# The command app stores zero credentials; the hub is the sole identity provider.
HUB_AUTH_URL=https://yabbai.network


# ── Solana RPC ────────────────────────────────────────────────────────────────

# Defaults to https://api.mainnet-beta.solana.com when unset.
#
# The public endpoint is not adequate for this app. It was measured returning
# HTTP 429 on getTokenLargestAccounts and refusing getProgramAccounts outright,
# which are the calls behind holder count and top-holder concentration. With the
# public endpoint those fields render DATA GAP rather than a number.
#
# Use a Helius (or equivalent) mainnet URL to get them:
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE


# ── Optional ──────────────────────────────────────────────────────────────────

DB_NAME=yabbai

# Raises Jupiter price rate limits. Prices work without it.
JUPITER_API_KEY=

# How often a real mainnet observation is written to price_history and
# treasury_snapshots. These rows are what /api/performance measures, so a longer
# interval means realised performance takes longer to become available.
SNAPSHOT_INTERVAL_SECONDS=300

# Comma-separated. Defaults to '*' — set explicitly for production.
CORS_ORIGINS=https://command.yabbai.network
